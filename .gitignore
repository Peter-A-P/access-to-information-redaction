# Private working notes, never committed
CLAUDE.local.md

# Secrets
.env
.env.*
*.key
*.pem

# Python
__pycache__/
*.py[cod]
.venv/
.mypy_cache/
.ruff_cache/
.pytest_cache/
dist/
build/
*.egg-info/

# Data (loaders fetch and verify; nothing raw is committed)
data/raw/
# The release packages themselves are not committed; the manifest that names them, with
# their checksums and source URLs, is. That is the whole reproducibility claim of the
# real-record track: anyone can obtain the same bytes from the same URLs.
data/releases/*
!data/releases/manifest.json
corpus/generated/
corpus/scans/

# Reviewer app state, audit databases, exports (the evaluation corpus copies are committed by checksum only)
*.duckdb
*.sqlite
*.sqlite3
review/exports/
.cache/

# OCR and model caches
tessdata/
models/

# OS and editors
.DS_Store
Thumbs.db
.vscode/
.idea/

# Generated results are committed (they are the evidence); scratch exports are not.
results/*.tmp

# The reviewer study's working folders: audit logs and raw timings, on the machine that ran it.
# What is committed is results/reviewer-study.jsonl, scored and carrying reviewer numbers only.
review/study/

# What `sever review` writes when run by hand: its audit log (with DuckDB's write-ahead
# file) and its timings. The study keeps its own under review/study/.
*.duckdb.wal
review/timings.jsonl
# Runs set aside rather than scored, kept on this machine only.
review/discarded/
review/trial/
